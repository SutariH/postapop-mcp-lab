# Copy this file to .env and fill in the values. Never commit .env.

# Required for the HTTP transport (step 6). A shared demo token.
# Make one with: openssl rand -hex 32
LAB_DEMO_TOKEN=

# Optional. The port for the HTTP transport. Default: 3333.
LAB_HTTP_PORT=

# Optional. Step 7: the public address of the OAuth server, with no trailing
# slash. Default: http://localhost:<LAB_HTTP_PORT>. Set it to your tunnel's
# https address when claude.ai or ChatGPT should connect.
LAB_ISSUER=

# Optional. Comma-separated browser origins that may call the HTTP transport.
# Default: none, so requests from web pages are refused.
LAB_ALLOWED_ORIGINS=

# Not used by the mock. A real API client would read its base URL and key here.
DEMO_API_URL=
DEMO_API_KEY=
